{
  "info": {
    "name": "Penta \u00e2\u20ac\u201d Loopr API",
    "description": "Financial transaction analytics API for the Penta dashboard. Import environment.json, enter credentials locally, and select it before running. Run all 15 requests in order with Postman's cookie jar enabled: Login sets an HttpOnly session cookie; Logout clears and revokes it. No bearer-token variable is needed. Amounts in JSON are integer USD cents; CSV amounts are decimal USD. Dates use UTC. Validation requests intentionally expect HTTP 400; the final request expects HTTP 401. Keep credentials and session cookies out of shared environment exports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health/live"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Process is healthy', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Database is ready', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "loopr"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Session cookie is HttpOnly', () => pm.expect(pm.response.headers.get('Set-Cookie')).to.include('HttpOnly'));",
              "pm.test('No password hash exposed', () => pm.expect(pm.response.json().user).not.to.have.property('passwordHash'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Current analyst",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Current analyst shape', () => { const user = pm.response.json().user; pm.expect(user).to.include.keys('id', 'email', 'name'); pm.expect(user).not.to.have.property('passwordHash'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Transactions \u00e2\u20ac\u201d page 1",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/transactions?page=1&pageSize=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Pagination contract', () => { const body = pm.response.json(); pm.expect(body.page).to.eql(1); pm.expect(body.items.length).to.be.at.most(20); pm.expect(body.total).to.be.a('number'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid page size",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/transactions?pageSize=1000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 400', () => pm.response.to.have.status(400));"]
          }
        }
      ]
    },
    {
      "name": "Filter metadata",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/transactions/metadata"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Metadata shape', () => pm.expect(pm.response.json().users).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Combined filtering and sorting",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/transactions?category=Revenue&status=Paid&userId=user_001&dateFrom=2024-01-01&dateTo=2024-12-31&amountMin=1000&sortBy=amountMinor&sortOrder=asc&pageSize=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Every result matches filters', () => pm.response.json().items.forEach(row => { pm.expect(row.category).to.eql('Revenue'); pm.expect(row.status).to.eql('Paid'); pm.expect(row.userId).to.eql('user_001'); pm.expect(row.amountMinor).to.be.at.least(100000); }));"
            ]
          }
        }
      ]
    },
    {
      "name": "Paid analytics",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/analytics?status=Paid"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Net equals revenue minus expenses', () => { const b = pm.response.json(); pm.expect(b.netCashFlowMinor).to.eql(b.paidRevenueMinor - b.paidExpenseMinor); pm.expect(b.pendingCount).to.eql(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Search",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/transactions?search=user_002"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Search matches user', () => pm.response.json().items.forEach(row => pm.expect(row.userId).to.eql('user_002')));"
            ]
          }
        }
      ]
    },
    {
      "name": "CSV selected columns",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "loopr"
          }
        ],
        "url": "{{baseUrl}}/exports",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": {\n    \"category\": \"Revenue\",\n    \"status\": \"Paid\",\n    \"pageSize\": 1\n  },\n  \"columns\": [\n    \"amount\",\n    \"date\",\n    \"userId\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('CSV content type', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'));",
              "pm.test('Column order and full-result export', () => { const lines = pm.response.text().replace(/^\\uFEFF/, '').trim().split('\\r\\n'); pm.expect(lines[0]).to.eql('Amount (USD),Date (UTC),User ID'); pm.expect(lines.length).to.be.greaterThan(2); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid export columns",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Requested-With",
            "value": "loopr"
          }
        ],
        "url": "{{baseUrl}}/exports",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": {},\n  \"columns\": [\n    \"passwordHash\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 400', () => pm.response.to.have.status(400));"]
          }
        }
      ]
    },
    {
      "name": "Reject inverted date range",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/transactions?dateFrom=2024-12-01&dateTo=2024-01-01"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 400', () => pm.response.to.have.status(400));"]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Requested-With",
            "value": "loopr"
          }
        ],
        "url": "{{baseUrl}}/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 204', () => pm.response.to.have.status(204));"]
          }
        }
      ]
    },
    {
      "name": "Reject access after logout",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 401', () => pm.response.to.have.status(401));"]
          }
        }
      ]
    }
  ]
}
